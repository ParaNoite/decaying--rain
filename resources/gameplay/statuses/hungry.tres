[gd_resource type="Resource" script_class="StatusEffectDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/status_effect_definition.gd" id="1_status"]

[resource]
script = ExtResource("1_status")
status_id = &"hungry"
display_name = "Hungry"
category = 2
description = "Food is depleted. Outgoing damage is reduced until hunger is restored."
is_permanent_until_removed = true
outgoing_damage_multiplier = 0.75
