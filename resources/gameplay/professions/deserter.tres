[resource]
script = ExtResource("1_profession")
profession_id = &"deserter"
display_name = "Deserter"
description = "Combat-oriented MVP perk. Starts with reliable weapon access and can fire a standalone charged beam active skill for testing."
starting_weapon_ids = Array[StringName]([&"crowbar", &"pistol"])
starting_item_ids = Array[StringName]([])
ammo_pickup_multiplier = 1.25
firearm_stability_multiplier = 1.0
status_ids_on_spawn = Array[StringName]([&"deserter_baseline"])
ability_id = &"deserter_charged_beam"
active_skill = ExtResource("2_skill")
advantages = Array[Resource]([ExtResource("3_advantage")])
disadvantages = Array[Resource]([ExtResource("4_disadvantage")])
