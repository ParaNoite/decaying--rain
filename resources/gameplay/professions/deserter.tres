[gd_resource type="Resource" script_class="ProfessionDefinition" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/resources/profession_definition.gd" id="1_profession"]
[ext_resource type="Resource" path="res://resources/gameplay/player_skills/deserter_charged_beam.tres" id="2_skill"]
